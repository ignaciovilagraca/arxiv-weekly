# Copy to .env (gitignored) and fill in. run.sh loads it.

# Anthropic API key (console.anthropic.com)
ARXIV_WEEKLY_ANTHROPIC_API_KEY=

# Token that `claude setup-token` prints. When the API key runs out of credits
# the claude CLI answers instead, on the Claude subscription.
ARXIV_WEEKLY_CLAUDE_OAUTH_TOKEN=

# Telegram bot that sends the recommendation, and the chat that receives it
ARXIV_WEEKLY_TELEGRAM_TOKEN=
ARXIV_WEEKLY_TELEGRAM_CHAT_ID=
